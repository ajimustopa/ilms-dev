{
  "name": "aldepos-sistem-root",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "npm --workspace=apps/api-backend run dev",
    "dev:portal": "npm --workspace=apps/core-portal run dev",
    "build:portal": "npm --workspace=apps/core-portal run build",
    "migrate:core": "npm --workspace=apps/api-backend run migrate",
    "seed:core": "npm --workspace=apps/api-backend run seed"
  }
}
