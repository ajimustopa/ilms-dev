# Core Service Environment Variables Example
# Duplicate this file to .env and adjust values for your environment.

# Server Configuration
CORE_NODE_ENV=development
CORE_PORT=3000

# Database Configuration (MariaDB / MySQL)
CORE_DB_HOST=127.0.0.1
CORE_DB_PORT=3306
CORE_DB_USER=root
CORE_DB_PASSWORD=your_database_password
CORE_DB_NAME=aldepos_core

# JWT Secrets & Expiration
CORE_JWT_SECRET=your_super_secret_jwt_access_token_key_here
CORE_JWT_EXPIRES_IN=1h
CORE_JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_here
CORE_JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting Global Default (Requests per Minute)
CORE_DEFAULT_RATE_LIMIT=100

# Webhook Configuration
CORE_WEBHOOK_TIMEOUT_MS=5000
CORE_WEBHOOK_MAX_RETRIES=3
